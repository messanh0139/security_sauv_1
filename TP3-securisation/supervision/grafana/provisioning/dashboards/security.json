{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["security", "tp3"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "TP3 — Supervision Sécurité",
  "uid": "tp3-security",
  "version": 1,
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Connexions réussies (1 h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "(sum(increase(login_attempts_total{status=\"success\"}[1h])) or vector(0))",
        "legendFormat": "Succès",
        "refId": "A"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Connexions échouées (1 h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "increase(login_attempts_total{status=\"failure\"}[1h])",
        "legendFormat": "Échecs",
        "refId": "A"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        }
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Connexions PG actives",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "pg_stat_activity_count{datname=\"tp3_users\",state=\"active\"}",
        "legendFormat": "Actives",
        "refId": "A"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Taux d'erreurs (1 h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "(sum(increase(login_attempts_total{status=\"error\"}[1h])) or vector(0))",
        "legendFormat": "Erreurs",
        "refId": "A"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        }
      }
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "Tentatives de connexion dans le temps",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(login_attempts_total{status=\"success\"}[1m])",
          "legendFormat": "Succès / s",
          "refId": "A"
        },
        {
          "expr": "rate(login_attempts_total{status=\"failure\"}[1m])",
          "legendFormat": "Échecs / s",
          "refId": "B"
        },
        {
          "expr": "rate(login_attempts_total{status=\"error\"}[1m])",
          "legendFormat": "Erreurs / s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Succès / s" },  "properties": [{ "id": "color", "value": { "fixedColor": "#28a745", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Échecs / s" },  "properties": [{ "id": "color", "value": { "fixedColor": "#dc3545", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Erreurs / s" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ffc107", "mode": "fixed" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Connexions PostgreSQL actives",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"tp3_users\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Transactions PostgreSQL / s",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"tp3_users\"}[1m])",
          "legendFormat": "Commits / s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"tp3_users\"}[1m])",
          "legendFormat": "Rollbacks / s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      }
    },

    {
      "id": 8,
      "type": "logs",
      "title": "Logs applicatifs en temps réel",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "{job=\"tp3-app\"}",
        "legendFormat": "",
        "refId": "A"
      }],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },

    {
      "id": 9,
      "type": "logs",
      "title": "Tentatives d'authentification échouées",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "{job=\"tp3-app\"} |= `LOGIN_FAILURE`",
        "legendFormat": "",
        "refId": "A"
      }],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
